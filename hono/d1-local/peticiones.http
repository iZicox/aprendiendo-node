// LISTAR TODOS
http://localhost:8787/api/products 
###

// LISTAR POR ID
@idExiste = 7
http://localhost:8787/api/products/{{idExiste}}
###
@idNoExiste = 9999999
http://localhost:8787/api/products/{{idNoExiste}}
###
// ELIMINAR

DELETE http://localhost:8787/api/products/7
###
// ELIMINAR FILA (MUESTRA TODOS LOS DATOS)
@id = 6
DELETE http://localhost:8787/api/products/fila/{{id}}
###
// INSERTAR
@contentType = application/json
@nombre = "teclado"
@precio = 15
@stock = 12
POST http://localhost:8787/api/products HTTP/1.1
Content-Type: {{contentType}}

{
    "name": {{nombre}},
    "price": {{precio}},
    "stock": {{stock}}
}

###
@contentType = application/json
@nombre = "cpu"
@precio = 1.20
@stock = 1
PATCH http://localhost:8787/api/products/2
Content-Type: {{contentType}}

{
    "name": {{nombre}}
}