# @name login
POST {{url}}/api/auth/login
Content-Type: application/json

{
    "email": "prueba@gmail.com",
    "password": "12345678"
}
###
@cookie = {{login.response.headers.Set-Cookie}}
GET http://127.0.0.1:8787/api/auth/me
 Cookie: {{cookie}}
