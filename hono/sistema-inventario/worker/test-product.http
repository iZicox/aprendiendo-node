
// PRODUCTS
@url = http://localhost:5173/api/products

// listar todos
GET {{url}}?page=39&pageSize=3
###
// buscar por SKU (parcial, sin distinguir mayúsculas)
GET {{url}}?page=1&pageSize=10&search=lap
###
// buscar sin coincidencias (debe devolver 200 con items vacíos)
GET {{url}}?search=ZZZ-NO-EXISTE
###
// listar por id
@idProduct = 2
GET {{url}}/{{idProduct}}
###
// listar por sku
@sku = LAP-ACER-15
GET {{url}}/sku/{{sku}}
###
// crear
POST http://localhost:5173/api/products
Content-Type: application/json

{
    "sku": "prueba"
}

###
// eliminar
DELETE http://localhost:5173/api/products/12
###

