
// PRODUCTS
@url = http://localhost:5173/api/products

// listar todos
GET {{url}}?page=39&pageSize=3
###
// listar por id
@idProduct = 2
GET {{url}}/{{idProduct}}
###
// listar por sku
@sku = LAP-ACER-15
GET {{url}}/sku/{{sku}}
###
// crear
POST http://localhost:5173/api/products
Content-Type: application/json

{
    "sku": "prueba"
}

