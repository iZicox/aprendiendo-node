// MOVEMENTS
@url = http://localhost:5173/api/movements

// listar todos (más recientes primero)
GET {{url}}
###
// listar por id
@idMovement = 1
GET {{url}}/{{idMovement}}
###
// listar por producto
@idProduct = 1
GET {{url}}/products/{{idProduct}}
###
// listar por ubicacion
@idLocation = 1
GET {{url}}/locations/{{idLocation}}
###
// listar por ubicacion y producto
GET {{url}}/locations/{{idLocation}}/products/{{idProduct}}
###
// crear movimiento (el signo se obtiene de movement_type)
POST {{url}}
Content-Type: application/json

{
    "productId": 1,
    "locationId": 2,
    "movementTypeCode": "ENTRY",
    "quantity": 5,
    "note": "Prueba de movimiento"
}

###
// crear transferencia atomica (TRANSFER_OUT + TRANSFER_IN)
POST {{url}}/transfer
Content-Type: application/json

{
    "productId": 1,
    "fromLocationId": 1,
    "toLocationId": 2,
    "quantity": 3,
    "transferId": "TRF-API-001",
    "note": "Transferencia de prueba"
}

###
