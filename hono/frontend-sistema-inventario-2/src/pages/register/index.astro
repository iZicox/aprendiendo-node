---
import AuthLayout from "../../layouts/AuthLayout.astro"

const inputClass =
  "w-full rounded-xl border border-stone-300 bg-stone-50 px-3.5 py-2.5 text-sm text-stone-900 shadow-sm transition placeholder:text-stone-400 focus:border-amber-500 focus:bg-white focus:ring-4 focus:ring-amber-500/15 focus:outline-none"
const labelClass = "mb-1.5 block text-sm font-medium text-stone-700"
const buttonClass =
  "inline-flex w-full items-center justify-center rounded-xl bg-amber-500 px-4 py-2.5 text-sm font-semibold text-stone-950 shadow-sm transition hover:bg-amber-400 focus-visible:ring-4 focus-visible:ring-amber-500/30 focus-visible:outline-none disabled:cursor-not-allowed disabled:opacity-60"
const linkClass =
  "font-semibold text-amber-700 underline-offset-4 hover:text-amber-800 hover:underline"
---

<AuthLayout
  title="Crear cuenta"
  subtitle="Registra tus datos para empezar a usar el sistema."
>
  <form id="register-form" method="post" class="space-y-4">
    <div>
      <label for="email" class={labelClass}>Correo electrónico</label>
      <input
        id="email"
        name="email"
        type="email"
        autocomplete="email"
        placeholder="tu@correo.com"
        required
        class={inputClass}
      />
    </div>

    <div>
      <label for="password" class={labelClass}>Contraseña</label>
      <div class="relative">
        <input
          id="password"
          name="password"
          type="password"
          autocomplete="new-password"
          placeholder="••••••••"
          minlength="8"
          aria-describedby="password-help"
          required
          class={`${inputClass} pr-11`}
        />
        <button
          id="toggle-password"
          type="button"
          class="absolute inset-y-0 right-0 grid w-11 place-items-center rounded-r-xl text-stone-400 transition-colors hover:text-stone-700 focus-visible:ring-2 focus-visible:ring-amber-500/40 focus-visible:ring-inset focus-visible:outline-none"
          aria-label="Mostrar contraseña"
          aria-pressed="false"
        >
          <svg
            data-eye-open
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            class="size-5"
            aria-hidden="true"
          >
            <path
              d="M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
            <circle
              cx="12"
              cy="12"
              r="3"
              stroke="currentColor"
              stroke-width="2"
            />
          </svg>
          <svg
            data-eye-closed
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            class="hidden size-5"
            aria-hidden="true"
          >
            <path
              d="M10.733 5.076a10.744 10.744 0 0 1 11.205 6.575 1 1 0 0 1 0 .696 10.747 10.747 0 0 1-1.444 2.49M14.084 14.158a3 3 0 0 1-4.242-4.242M17.479 17.499a10.75 10.75 0 0 1-15.417-5.151 1 1 0 0 1 0-.696 10.75 10.75 0 0 1 4.446-5.143M2 2l20 20"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </button>
      </div>
      <p id="password-help" class="mt-1.5 text-xs text-stone-500">
        Usa al menos 8 caracteres.
      </p>
    </div>

    <div
      id="mensaje"
      role="status"
      aria-live="polite"
      class="hidden rounded-xl border px-3.5 py-2.5 text-sm"
    >
    </div>

    <button id="register" type="submit" class={buttonClass}>
      Crear cuenta
    </button>
  </form>

  <p class="mt-6 text-center text-sm text-stone-500">
    ¿Ya tienes cuenta?{" "}
    <a href="/login" class={linkClass}>Iniciar sesión</a>
  </p>
</AuthLayout>

<script>
  const API_URL = "http://localhost:8788"

  const form = document.getElementById("register-form") as HTMLFormElement
  const button = document.getElementById("register") as HTMLButtonElement
  const message = document.getElementById("mensaje") as HTMLDivElement
  const emailInput = document.getElementById("email") as HTMLInputElement
  const passwordInput = document.getElementById("password") as HTMLInputElement
  const togglePassword = document.getElementById(
    "toggle-password",
  ) as HTMLButtonElement
  const buttonLabel = button.textContent ?? "Crear cuenta"

  const showMessage = (text: string, type: "error" | "success") => {
    message.textContent = text
    message.className = `rounded-xl border px-3.5 py-2.5 text-sm ${
      type === "success"
        ? "border-emerald-200 bg-emerald-50 text-emerald-700"
        : "border-red-200 bg-red-50 text-red-700"
    }`
  }

  togglePassword.addEventListener("click", () => {
    const show = passwordInput.type === "password"

    passwordInput.type = show ? "text" : "password"
    togglePassword.setAttribute("aria-pressed", String(show))
    togglePassword.setAttribute(
      "aria-label",
      show ? "Ocultar contraseña" : "Mostrar contraseña",
    )
    togglePassword
      .querySelector("[data-eye-open]")
      ?.classList.toggle("hidden", show)
    togglePassword
      .querySelector("[data-eye-closed]")
      ?.classList.toggle("hidden", !show)
  })

  form.addEventListener("submit", async (event) => {
    event.preventDefault()
    message.classList.add("hidden")

    const email = emailInput.value.trim()
    const password = passwordInput.value

    if (password.length < 8) {
      showMessage("La contraseña debe tener al menos 8 caracteres.", "error")
      return
    }

    let success = false
    button.disabled = true
    button.textContent = "Creando cuenta..."

    try {
      const res = await fetch(`${API_URL}/api/auth/register`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        credentials: "include",
        body: JSON.stringify({ email, password }),
      })

      const data = await res.json().catch(() => null)

      if (!res.ok) {
        showMessage(
          typeof data?.error === "string"
            ? data.error
            : "No se pudo crear la cuenta. Inténtalo de nuevo.",
          "error",
        )
        return
      }

      success = true
      button.textContent = "Redirigiendo..."
      showMessage(
        "Cuenta creada correctamente. Redirigiendo al inicio de sesión...",
        "success",
      )

      window.setTimeout(() => {
        window.location.replace(
          `/login?registered=1&email=${encodeURIComponent(email)}`,
        )
      }, 1200)
    } catch (error) {
      console.error("Error en registro:", error)
      showMessage("No se pudo conectar con el servidor.", "error")
    } finally {
      if (!success) {
        button.disabled = false
        button.textContent = buttonLabel
      }
    }
  })
</script>
